{
  "name": "transcendence-backend",
  "version": "1.0.0",
  "description": "Transcendence Microservices Backend",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:user\" \"npm run dev:game\" \"npm run dev:file\"",
    "dev:gateway": "cd api-gateway && npm run dev",
    "dev:auth": "cd auth-service && npm run dev",
    "dev:user": "cd user-service && npm run dev",
    "dev:game": "cd game-service && npm run dev",
    "dev:file": "cd file-service && npm run dev",
    "build": "npm run build:gateway && npm run build:auth && npm run build:user && npm run build:game && npm run build:file",
    "build:gateway": "cd api-gateway && npm run build",
    "build:auth": "cd auth-service && npm run build",
    "build:user": "cd user-service && npm run build",
    "build:game": "cd game-service && npm run build",
    "build:file": "cd file-service && npm run build",
    "install:all": "npm install && cd api-gateway && npm install && cd ../auth-service && npm install && cd ../user-service && npm install && cd ../game-service && npm install && cd ../file-service && npm install",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": ["microservices", "fastify", "nodejs", "sqlite", "transcendence"],
  "author": "Transcendence Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "workspaces": [
    "api-gateway",
    "auth-service", 
    "user-service",
    "game-service",
    "file-service",
    "shared"
  ]
} 