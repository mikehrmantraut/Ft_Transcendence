{
  "name": "@transcendence/auth-service",
  "version": "1.0.0",
  "description": "Authentication service for Transcendence",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "db:migrate": "ts-node src/database/migrate.ts"
  },
  "keywords": ["auth", "fastify", "sqlite", "jwt"],
  "author": "Transcendence Team",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.25.2",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/env": "^4.3.0",
    "@fastify/cookie": "^9.3.1",
    "@transcendence/shared": "file:../shared",
    "sqlite3": "^5.1.6",
    "better-sqlite3": "^9.4.0",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "@types/node": "^20.10.7",
    "@types/better-sqlite3": "^7.6.8",
    "rimraf": "^5.0.5"
  }
} 